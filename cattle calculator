<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Button BidCalc</title>
  <style>
    body {
      font-family: sans-serif;
      padding: 1rem;
      max-width: 600px;
      margin: auto;
      background: #f9f9f9;
    }
    h1 {
      text-align: center;
    }
    label {
      display: block;
      margin-top: 1rem;
    }
    input, select {
      width: 100%;
      padding: 0.5rem;
      margin-top: 0.25rem;
      font-size: 1rem;
    }
    button {
      margin-top: 1.5rem;
      padding: 0.75rem;
      width: 100%;
      font-size: 1rem;
      background: #333;
      color: white;
      border: none;
      cursor: pointer;
    }
    .output {
      margin-top: 2rem;
      background: #fff;
      padding: 1rem;
      border-radius: 8px;
      box-shadow: 0 0 5px rgba(0,0,0,0.1);
    }
    .output p {
      margin: 0.5rem 0;
    }
  </style>
</head>
<body>
  <h1>🐂 Button BidCalc</h1>

  <label for="location">Auction Location</label>
  <select id="location">
    <option value="STLA">Santa Teresa, NM ⭐</option>
    <option value="Amarillo">Amarillo, TX</option>
    <option value="OKC">Oklahoma City, OK</option>
    <option value="Joplin">Joplin, MO</option>
    <option value="Custom">Other (manual)</option>
  </select>

  <label for="kind">Kind</label>
  <select id="kind">
    <option value="MX Steer">Mexican Steer</option>
    <option value="MX Heifer">Mexican Heifer</option>
    <option value="Domestic Steer">Domestic Steer</option>
    <option value="Domestic Heifer">Domestic Heifer</option>
  </select>

  <label for="head">Head Count</label>
  <input type="number" id="head" value="100" />

  <label for="weight">Average Weight (lbs)</label>
  <input type="number" id="weight" value="620" />

  <label for="days">Days on Feed</label>
  <input type="number" id="days" value="120" />

  <label for="salePrice">Projected Sale Price ($/cwt)</label>
  <input type="number" id="salePrice" value="210" />

  <button onclick="calculate()">Calculate</button>

  <div class="output" id="results"></div>

  <script>
    const priceGrid = {
      "STLA": {
        "MX Steer": [370, 385, 400],
        "MX Heifer": [310, 327, 340],
        "Domestic Steer": [240, 260, 280],
        "Domestic Heifer": [220, 240, 260]
      },
      "Amarillo": {
        "Domestic Steer": [250, 265, 280],
        "Domestic Heifer": [230, 245, 260]
      },
      "OKC": {
        "Domestic Steer": [245, 260, 275],
        "Domestic Heifer": [225, 240, 255]
      },
      "Joplin": {
        "Domestic Steer": [240, 255, 270],
        "Domestic Heifer": [220, 235, 250]
      }
    };

    function calculate() {
      const location = document.getElementById("location").value;
      const kind = document.getElementById("kind").value;
      const head = parseInt(document.getElementById("head").value);
      const weight = parseFloat(document.getElementById("weight").value);
      const days = parseInt(document.getElementById("days").value);
      const salePrice = parseFloat(document.getElementById("salePrice").value);

      const feedCostPerDay = 2.25; // avg from invoices
      const interestPerDay = 0.30;

      const feedCost = feedCostPerDay * days * head;
      const interestCost = interestPerDay * days * head;

      const bidPrices = (priceGrid[location] && priceGrid[location][kind]) || [0, 0, 0];

      let html = `<h2>Results</h2>`;
      bidPrices.forEach((bid, i) => {
        const purchaseCost = (bid * weight / 100) * head;
        const totalCost = purchaseCost + feedCost + interestCost;
        const projectedWeight = weight + (days * 3); // 3 lbs/day gain
        const saleValue = (salePrice * projectedWeight / 100) * head;
        const profit = saleValue - totalCost;
        const label = ["Low", "Mid", "High"][i];

        html += `<p><strong>${label} Bid @ $${bid}/cwt</strong></p>`;
        html += `<p>Purchase Cost: $${purchaseCost.toFixed(2)}</p>`;
        html += `<p>Feed Cost: $${feedCost.toFixed(2)}</p>`;
        html += `<p>Interest: $${interestCost.toFixed(2)}</p>`;
        html += `<p>Total Cost to Raise: $${totalCost.toFixed(2)}</p>`;
        html += `<p>Projected Sale Value: $${saleValue.toFixed(2)}</p>`;
        html += `<p>Net Profit: $${profit.toFixed(2)}</p><hr>`;
      });

      document.getElementById("results").innerHTML = html;
    }
  </script>
</body>
</html>
